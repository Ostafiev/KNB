# Скопируй в backend/.env и поправь под себя.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Хранилища. В docker compose адреса подставляются автоматически,
# эти значения — для запуска без Docker.
DATABASE_URL=postgres://knb:knb_dev_password@localhost:5432/knb
REDIS_URL=redis://localhost:6379

# Токен бота из BotFather. Нужен на этапе 2 для проверки подписи initData.
TELEGRAM_BOT_TOKEN=

# Секреты. В проде обязательно свои, не меньше 32 символов.
# Сгенерировать: openssl rand -base64 32
ADMIN_SESSION_SECRET=
AUTH_TOKEN_SECRET=

# Папка со сборкой Mini App. Если задана, сервер отдаёт приложение сам,
# и фронтенд с API живут на одном адресе.
FRONTEND_DIST=../frontend/dist

# Откуда разрешены запросы. Для разработки достаточно *,
# в проде — адрес Mini App.
CORS_ORIGINS=*
