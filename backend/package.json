{
  "name": "knb-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file=.env src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "verify:stage2": "tsx --env-file=.env src/dev/verifyStage2.ts",
    "verify:stage4": "tsx --env-file=.env src/dev/verifyStage4.ts",
    "verify:stage5": "tsx --env-file=.env src/dev/verifyStage5.ts",
    "verify:stage6": "tsx --env-file=.env src/dev/verifyStage6.ts",
    "verify:stage7": "tsx --env-file=.env src/dev/verifyStage7.ts",
    "verify:stage8": "tsx --env-file=.env src/dev/verifyStage8.ts",
    "verify:share": "tsx --env-file=.env src/dev/verifyShare.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
